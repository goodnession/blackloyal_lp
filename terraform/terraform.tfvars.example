# Terraform Variables Example
# Copy this file to terraform.tfvars and fill in your values

# Timeweb Cloud API token
twc_token = "your_timeweb_cloud_api_token"

# Domain name for the application
domain = "your-domain.com"

# Existing server configuration
server_id = "your_existing_server_id"
server_ip = "123.456.789.0"

# SSH configuration
# NOTE: SSH public key must be manually added to the server before running Terraform
# Add your public key to /root/.ssh/authorized_keys on the server
ssh_private_key = "-----BEGIN OPENSSH PRIVATE KEY-----\nb3BlbnNzaC1rZXktdjEAAAAABG5vbmUAAAAEbm9uZQAAAAAAAAABAAABlwAAAAdzc2gtcn\n...\n-----END OPENSSH PRIVATE KEY-----"

# Project name
project_name = "blackloyal"