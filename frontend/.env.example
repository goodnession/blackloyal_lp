# ========================================
# BlackLoyal Landing Page - Environment Variables
# ========================================

# ===================
# Required Variables
# ===================

# Site Configuration
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Telegram Bot Configuration (for lead notifications)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ===================
# Optional Variables
# ===================

# Analytics
NUXT_PUBLIC_ANALYTICS_ID=your_yandex_metrica_id_here

# Telegram Bot Public Info
NUXT_PUBLIC_TELEGRAM_BOT_USERNAME=your_bot_username

# Contact Information
CONTACT_PHONE=+7 (XXX) XXX-XX-XX
CONTACT_EMAIL=hello@blackloyal.ru

# ===================
# Development Only
# ===================

# Node Environment (automatically set by Nuxt)
# NODE_ENV=development

# ===================
# How to use this file:
# ===================
# 1. Copy this file to .env.development for local development:
#    cp .env.example .env.development
#
# 2. Fill in your actual values
#
# 3. Never commit .env files to Git!
#
# ===================
# How to get values:
# ===================
#
# TELEGRAM_BOT_TOKEN:
#   1. Open Telegram and search for @BotFather
#   2. Send /newbot command
#   3. Follow instructions to create a bot
#   4. Copy the token provided
#
# TELEGRAM_CHAT_ID:
#   1. Add your bot to a group or channel
#   2. Send a message to the group/channel
#   3. Visit: https://api.telegram.org/bot<YOUR_BOT_TOKEN>/getUpdates
#   4. Find "chat":{"id": in the response
#   5. Copy the id value
#
# NUXT_PUBLIC_ANALYTICS_ID:
#   1. Go to https://metrica.yandex.ru
#   2. Create a new counter
#   3. Copy the counter ID
#
